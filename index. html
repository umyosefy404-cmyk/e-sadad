<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:system-ui,'Segoe UI',Tahoma,sans-serif}
body{background:#f1f5f9;color:#0f172a;padding:12px;padding-bottom:30px}
header{background:linear-gradient(135deg,#1e40af,#3b82f6);color:#fff;padding:14px;border-radius:12px;margin-bottom:12px}
header h1{font-size:15px;font-weight:700}
header .s{font-size:11px;opacity:.85;margin-top:2px}
select{width:100%;padding:12px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:14px;font-weight:600;margin-bottom:12px;background:#fff;outline:none}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px}
.kpi{background:#fff;border-radius:14px;padding:12px;border-right:4px solid #3b82f6;box-shadow:0 2px 8px rgba(0,0,0,.05)}
.kpi.g{border-color:#10b981}.kpi.o{border-color:#f59e0b}.kpi.p{border-color:#8b5cf6}
.kpi .l{font-size:10.5px;color:#64748b;font-weight:600;margin-bottom:5px}
.kpi .v{font-size:17px;font-weight:800;color:#3b82f6;font-variant-numeric:tabular-nums}
.kpi.g .v{color:#10b981}.kpi.o .v{color:#f59e0b}.kpi.p .v{color:#8b5cf6}
.card{background:#fff;border-radius:14px;padding:14px;box-shadow:0 2px 8px rgba(0,0,0,.05);margin-bottom:12px}
.card h3{font-size:13px;color:#1e40af;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid #e2e8f0}
.srch{width:100%;padding:10px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;margin-bottom:8px;outline:none}
.ts{overflow-x:auto;max-height:60vh;overflow-y:auto;-webkit-overflow-scrolling:touch}
table{width:100%;border-collapse:collapse;font-size:12px;min-width:420px}
thead{position:sticky;top:0;background:#fff;z-index:2}
th{background:#eff6ff;color:#1e40af;padding:9px 8px;text-align:right;font-size:11px;border-bottom:1px solid #e2e8f0}
td{padding:9px 8px;text-align:right;border-bottom:1px solid #e2e8f0}
td.n{font-weight:700;color:#3b82f6;font-variant-numeric:tabular-nums;white-space:nowrap}
td.p{color:#10b981;font-weight:600;font-size:11.5px;white-space:nowrap}
.bm{display:inline-block;height:5px;background:#3b82f6;border-radius:3px;vertical-align:middle;margin-left:5px;max-width:40px}
.chart{height:340px;position:relative}
</style>
