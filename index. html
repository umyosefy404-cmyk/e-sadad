var N=function(x){return Number(x).toLocaleString('en-US')};
var myChart=null;
var sel=document.getElementById('sel');
Object.keys(D).forEach(function(k){var o=document.createElement('option');o.value=k;o.textContent=k+' ('+N(D[k][0])+')';sel.appendChild(o)});
function drawChart(rows){
  var top=rows.slice(0,10);
  if(myChart)myChart.destroy();
  myChart=new Chart(document.getElementById('bc'),{type:'bar',data:{labels:top.map(function(r){return r[1].length>28?r[1].substring(0,28)+'…':r[1]}),datasets:[{data:top.map(function(r){return r[2]}),backgroundColor:'#3b82f6',borderRadius:6}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{rtl:true,textDirection:'rtl',callbacks:{label:function(c){return N(c.raw)}}}},scales:{x:{ticks:{font:{size:10},color:'#64748b'},grid:{color:'#e2e8f0'}},y:{ticks:{font:{size:10},color:'#0f172a'},grid:{display:false}}}}});
}
function drawTable(rows,total){
  var tb=document.getElementById('tb');
  if(!rows.length){tb.innerHTML='<tr><td colspan="4" style="text-align:center;padding:30px;color:#94a3b8">لا توجد نتائج</td></tr>';return}
  tb.innerHTML=rows.map(function(r){var pct=total?(r[2]/total*100):0;var w=Math.max(3,Math.min(40,pct*1.5));return '<tr><td>'+r[0]+'</td><td>'+r[1]+'</td><td class="n">'+N(r[2])+'</td><td class="p"><span class="bm" style="width:'+w+'px"></span>'+pct.toFixed(2)+'%</td></tr>'}).join('');
}
function load(name){
  var c=D[name];if(!c)return;
  var t=c[0],o=c[1],s=c[2],str=c[3];
  document.getElementById('k1').textContent=N(t);
  document.getElementById('k2').textContent=N(o);
  document.getElementById('k3').textContent=N(s);
  document.getElementById('k4').textContent=s?N(Math.round(t/s)):'0';
  document.getElementById('sub').textContent=name;
  var rows=str.split('~').map(function(x){var p=x.split('|');return [p[0],p[1],parseInt(p[2])||0]}).filter(function(r){return r[2]>0}).sort(function(a,b){return b[2]-a[2]});
  drawChart(rows);drawTable(rows,t);
  document.getElementById('srch').value='';
  document.getElementById('srch').oninput=function(e){var q=e.target.value.trim();drawTable(q?rows.filter(function(r){return r[0].indexOf(q)>-1||r[1].indexOf(q)>-1}):rows,t)};
}
sel.onchange=function(){load(sel.value)};
load(Object.keys(D)[0]);
